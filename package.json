{
  "name": "calculator",
  "version": "1.0.1",
  "private": true,
  "description": "Calculator – cross-platform calculator for Web, Windows, macOS, Linux, Android and iOS",
  "author": {
    "name": "Md. Amzad Hossain Roni",
    "email": "ahroni.usa@gmail.com"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "vite build --mode pages",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview",
    "desktop:dev": "npm run build && electron .",
    "desktop:win": "npm run build && electron-builder --win nsis portable --publish never",
    "desktop:mac": "npm run build && electron-builder --mac dmg --publish never",
    "desktop:linux": "npm run build && electron-builder --linux deb --publish never",
    "android:add": "npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "ios:add": "npx cap add ios",
    "ios:sync": "npm run build && npx cap sync ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "bootstrap": "^5.3.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.2.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
